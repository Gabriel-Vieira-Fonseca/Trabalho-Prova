
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jogadores | Football Manager</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background: #101713;
            color: #fff;
            min-height: 100vh;
        }

        .sidebar {
            width: 240px;
            height: 100vh;
            background: #17221b;
            position: fixed;
            left: 0;
            top: 0;
            padding: 30px 20px;
            border-right: 1px solid #26352b;
        }

        .logo {
            font-size: 21px;
            font-weight: 800;
            color: #54e38e;
            margin-bottom: 50px;
        }

        .logo span {
            color: white;
        }

        .menu-title {
            color: #718078;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            margin-bottom: 18px;
        }

        .menu a {
            display: block;
            padding: 14px;
            margin-bottom: 8px;
            color: #a5b3aa;
            text-decoration: none;
            border-radius: 9px;
            font-size: 14px;
            transition: .3s;
        }

        .menu a:hover,
        .menu a.active {
            background: #263b2d;
            color: #54e38e;
        }

        .main {
            margin-left: 240px;
            padding: 40px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
        }

        .topbar h1 {
            font-size: 27px;
            font-weight: 800;
        }

        .topbar p {
            color: #829087;
            font-size: 13px;
            margin-top: 7px;
        }

        .profile {
            background: #1c2921;
            padding: 11px 17px;
            border-radius: 10px;
            color: #54e38e;
            font-size: 13px;
            font-weight: 600;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 35px;
        }

        .stat-card {
            background: #19251e;
            border: 1px solid #29382e;
            border-radius: 13px;
            padding: 23px;
        }

        .stat-card p {
            color: #94a198;
            font-size: 13px;
            margin-bottom: 15px;
        }

        .stat-card h2 {
            font-size: 29px;
            color: #54e38e;
        }

        .stat-card span {
            color: #77857b;
            font-size: 12px;
        }

        .table-container {
            background: #19251e;
            border: 1px solid #29382e;
            border-radius: 15px;
            padding: 25px;
            overflow: hidden;
        }

        .table-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            gap: 15px;
        }

        .table-header h2 {
            font-size: 19px;
        }

        .search {
            background: #101713;
            border: 1px solid #34463a;
            padding: 11px 15px;
            border-radius: 8px;
            color: white;
            outline: none;
            width: 250px;
        }

        .search:focus {
            border-color: #54e38e;
        }

        .table-scroll {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 650px;
        }

        thead {
            background: #202f25;
        }

        th {
            color: #849389;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 17px 15px;
            text-align: left;
        }

        td {
            padding: 18px 15px;
            border-bottom: 1px solid #2a382e;
            font-size: 13px;
            color: #d6dfd9;
        }

        tbody tr {
            transition: .2s;
        }

        tbody tr:hover {
            background: #213228;
        }

        .player-id {
            color: #6c7b71;
        }

        .player-name {
            color: white;
            font-weight: 700;
        }

        .position {
            background: #27392c;
            color: #71e99b;
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
            display: inline-block;
        }

        .price {
            color: #54e38e;
            font-weight: 700;
        }

        .club {
            color: #dce5df;
            font-weight: 600;
        }

        .empty {
            text-align: center;
            padding: 35px;
            color: #829087;
        }

        @media(max-width: 900px) {
            .sidebar {
                width: 190px;
            }

            .main {
                margin-left: 190px;
                padding: 25px;
            }

            .stats {
                grid-template-columns: 1fr;
            }
        }

        @media(max-width: 600px) {
            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                padding: 20px 12px;
            }

            .topbar {
                align-items: flex-start;
            }

            .topbar h1 {
                font-size: 22px;
            }

            .profile {
                display: none;
            }

            .table-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .search {
                width: 100%;
            }

            .table-container {
                padding: 15px;
            }
        }
        .player-info {
    display: flex;
    align-items: center;
    gap: 12px;
    }

    .player-photo {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #54e38e;
        background: #26352b;
    }

    .player-name {
        color: white;
        font-weight: 700;
    }
    </style>
    </head>

<body>

    <aside class="sidebar">
        <div class="logo">FOOT<span>MANAGER</span></div>

        <p class="menu-title">MENU PRINCIPAL</p>

        <nav class="menu">
            <a href="/">⌂ Dashboard</a>
            <a href="/jogadores" class="active">⚽ Jogadores</a>
            <a href="/clubes">🏆 Clubes</a>
            <a href="/nacionalidades">🌎 Nacionalidades</a>
        </nav>
    </aside>

    <main class="main">

        <header class="topbar">
            <div>
                <h1>Jogadores</h1>
                <p>Gerencie e acompanhe os jogadores cadastrados no sistema.</p>
            </div>

            <div class="profile">
                ⚽ Football Manager
            </div>
        </header>

        <section class="stats">

            <div class="stat-card">
                <p>Total de jogadores</p>
                <h2><%= jogadores.length %></h2>
                <span>Jogadores cadastrados</span>
            </div>

            <div class="stat-card">
                <p>Clubes cadastrados</p>
                <h2><%= new Set(jogadores.map(j => j.nome_clube)).size %></h2>
                <span>Clubes representados</span>
            </div>

            <div class="stat-card">
                <p>Nacionalidades</p>
                <h2><%= new Set(jogadores.map(j => j.nacionalidade)).size %></h2>
                <span>Países representados</span>
            </div>

        </section>

        <section class="table-container">

            <div class="table-header">
                <h2>Lista de jogadores</h2>

                <input
                    type="text"
                    id="pesquisa"
                    class="search"
                    placeholder="Pesquisar jogador..."
                >
            </div>

            <div class="table-scroll">
                <table id="tabelaJogadores">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Jogador</th>
                            <th>Posição</th>
                            <th>Preço</th>
                            <th>Nacionalidade</th>
                            <th>Clube</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% jogadores.forEach(jogador => { %>

                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <img
                                            src="<%= jogador.foto %>"
                                            alt="<%= jogador.nome_jogador %>"
                                            style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover; object-position: top;"
                                        />
                                        <span>#<%= jogador.id_jogador %></span>
                                    </div>
                                </td>
                                <td class="player-id">
                                    #<%= jogador.id_jogador %>
                                </td>
                                
                                <td class="player-name">
                                    <%= jogador.nome %>
                                </td>

                                <td>
                                    <span class="position">
                                        <%= jogador.posicao %>
                                    </span>
                                </td>

                                <td class="price">
                                    <%= jogador.preco %>
                                </td>

                                <td>
                                    <%= jogador.nacionalidade %>
                                </td>

                                <td class="club">
                                    <%= jogador.nome_clube %>
                                </td>
                            </tr>

                        <% }) %>

                    </tbody>

                </table>
            </div>

            <p id="semResultado" class="empty" style="display:none;">
                Nenhum jogador encontrado.
            </p>

        </section>

    </main>

    <script>
        const pesquisa = document.getElementById('pesquisa');
        const linhas = document.querySelectorAll('#tabelaJogadores tbody tr');
        const semResultado = document.getElementById('semResultado');

        pesquisa.addEventListener('input', function() {

            const valor = this.value.toLowerCase();
            let encontrados = 0;

            linhas.forEach(linha => {

                const texto = linha.textContent.toLowerCase();

                if (texto.includes(valor)) {
                    linha.style.display = '';
                    encontrados++;
                } else {
                    linha.style.display = 'none';
                }

            });

            semResultado.style.display = encontrados === 0 ? 'block' : 'none';

        });
    </script>

</body>
</html>
