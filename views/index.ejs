<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Meu elenco</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --grama:#14532d; --grama-2:#1c6e3c; --giz:#f3f6f1; --tinta:#10201a;
    --amarelo:#f4c20d; --vermelho:#c62828; --linha:#d3dcd0; --suave:#5d6e63;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--giz);color:var(--tinta);font-family:'Barlow',system-ui,sans-serif;line-height:1.45}
  h1,h2,h3{font-family:'Barlow Condensed',sans-serif;font-weight:700;margin:0;letter-spacing:.01em}
  button,input,select{font:inherit}
  :focus-visible{outline:3px solid var(--amarelo);outline-offset:2px}

  /* topo */
  .topo{background:var(--grama);color:#fff;padding:28px 24px 0}
  .topo-in{max-width:1120px;margin:0 auto}
  .topo h1{font-size:clamp(34px,6vw,56px);line-height:1}
  .resumo{display:flex;gap:28px;flex-wrap:wrap;margin:10px 0 22px;color:#cfe6d6}
  .resumo b{color:#fff;font-weight:600}
  .abas{display:flex;gap:4px}
  .aba{border:0;cursor:pointer;padding:11px 22px;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:20px;
       background:rgba(255,255,255,.12);color:#fff;border-radius:10px 10px 0 0}
  .aba[aria-selected="true"]{background:var(--giz);color:var(--grama)}

  main{max-width:1120px;margin:0 auto;padding:24px}
  section[hidden]{display:none}

  /* barra de ações */
  .acoes{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:18px}
  .busca{display:flex;flex:1;min-width:240px;max-width:520px}
  .busca input{flex:1;padding:11px 14px;border:1.5px solid var(--linha);border-right:0;border-radius:10px 0 0 10px;background:#fff}
  .busca button{border-radius:0 10px 10px 0}
  .limpar-busca{align-self:center;color:var(--suave)}

  .btn{border:0;border-radius:10px;padding:9px 16px;font-weight:600;cursor:pointer;background:var(--grama);color:#fff}
  .btn:hover{filter:brightness(1.12)}
  .btn.p{padding:6px 12px;font-size:14px}
  .btn.amarelo{background:var(--amarelo);color:#3a2e00}
  .btn.vermelho{background:var(--vermelho)}
  .btn.claro{background:#fff;color:var(--grama);border:1.5px solid var(--linha)}

  /* tabela */
  .tabela-wrap{overflow-x:auto;background:#fff;border:1.5px solid var(--linha);border-radius:14px}
  table{width:100%;border-collapse:collapse;min-width:820px}
  th{text-align:left;font-weight:600;font-size:14px;color:var(--suave);padding:12px 14px;border-bottom:1.5px solid var(--linha);background:#f8faf7}
  td{padding:10px 14px;border-bottom:1px solid #ecf0ea;vertical-align:middle}
  tr:last-child td{border-bottom:0}
  .num{text-align:right;font-variant-numeric:tabular-nums}
  .id{color:var(--suave);font-variant-numeric:tabular-nums}
  .nome{font-weight:600}
  .pos{display:inline-block;padding:2px 10px;border-radius:99px;font-size:13px;font-weight:600;background:#e4efe7;color:var(--grama)}
  .linha-acoes{display:flex;gap:6px;justify-content:flex-end}
  .linha-acoes form{margin:0}
  .vazio{padding:40px;text-align:center;color:var(--suave)}

  .foto{width:44px;height:44px;border-radius:50%;object-fit:cover;background:#dfe8e0;display:grid;place-items:center;
        font-weight:700;color:var(--grama);overflow:hidden;flex:none}
  .foto img{width:100%;height:100%;object-fit:cover}

  /* escalação */
  .escalacao{display:grid;grid-template-columns:minmax(300px,520px) 1fr;gap:28px;align-items:start}
  @media(max-width:860px){.escalacao{grid-template-columns:1fr}}
  .campo{position:relative;width:100%;aspect-ratio:2/3;border-radius:16px;overflow:hidden;
         background:repeating-linear-gradient(0deg,var(--grama-2) 0 9.09%,#195f35 9.09% 18.18%);
         border:4px solid var(--grama)}
  .marca{position:absolute;border:2px solid rgba(255,255,255,.65);pointer-events:none}
  .marca.moldura{inset:3%;border-radius:2px}
  .marca.meio{left:3%;right:3%;top:50%;border-width:2px 0 0}
  .marca.circulo{width:26%;aspect-ratio:1;left:37%;top:calc(50% - 8.67%);border-radius:50%}
  .marca.area-cima{left:25%;right:25%;top:3%;height:13%;border-top:0}
  .marca.area-baixo{left:25%;right:25%;bottom:3%;height:13%;border-bottom:0}
  .slot{position:absolute;transform:translate(-50%,-50%);width:84px;padding:0;border:0;background:none;color:#fff;cursor:pointer;text-align:center}
  .slot .bola{width:54px;height:54px;margin:0 auto;border-radius:50%;display:grid;place-items:center;overflow:hidden;
              border:2px dashed rgba(255,255,255,.8);background:rgba(0,0,0,.18);font-size:22px;font-weight:700}
  .slot.cheio .bola{border:2px solid #fff;background:#fff;color:var(--grama);font-size:18px}
  .slot .bola img{width:100%;height:100%;object-fit:cover}
  .slot .rotulo{display:block;margin-top:3px;font-size:12.5px;font-weight:600;line-height:1.1;text-shadow:0 1px 3px rgba(0,0,0,.7)}
  .slot:hover .bola{transform:scale(1.07)}
  .slot .bola{transition:transform .12s}

  .painel{background:#fff;border:1.5px solid var(--linha);border-radius:14px;padding:20px}
  .painel h2{font-size:26px;margin-bottom:12px}
  .controles{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:16px}
  .controles select{padding:9px 12px;border-radius:10px;border:1.5px solid var(--linha);background:#fff}
  .lista-time{list-style:none;margin:0 0 14px;padding:0}
  .lista-time li{display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid #ecf0ea}
  .lista-time .foto{width:34px;height:34px;font-size:13px}
  .lista-time .quem{flex:1;min-width:0}
  .lista-time small{color:var(--suave);display:block}
  .lista-time .livre{color:var(--suave);font-style:italic}
  .total{display:flex;justify-content:space-between;font-weight:600;font-size:18px;padding-top:6px}

  /* dialogs */
  dialog{border:0;border-radius:16px;padding:0;width:min(480px,92vw);box-shadow:0 20px 60px rgba(0,0,0,.35)}
  dialog::backdrop{background:rgba(10,30,18,.6)}
  .dlg{padding:22px}
  .dlg h3{font-size:28px;margin-bottom:14px}
  .dlg label{display:block;font-size:14px;font-weight:600;margin:10px 0 4px}
  .dlg input,.dlg select{width:100%;padding:10px 12px;border:1.5px solid var(--linha);border-radius:10px;background:#fff}
  .dlg .duas{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .dlg .rodape{display:flex;justify-content:flex-end;gap:8px;margin-top:20px}
  #lista-escolha{list-style:none;margin:12px 0 0;padding:0;max-height:48vh;overflow:auto}
  #lista-escolha button{display:flex;align-items:center;gap:12px;width:100%;text-align:left;padding:8px;border:0;background:none;border-radius:10px;cursor:pointer}
  #lista-escolha button:hover{background:#eef4ee}
  #lista-escolha .quem{flex:1}
  #lista-escolha small{color:var(--suave);display:block}
  #lista-escolha .usado{font-size:12px;color:var(--suave)}
  .check{display:flex;gap:8px;align-items:center;margin-top:10px;font-size:14px;color:var(--suave)}
  .check input{width:auto}

  #aviso{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:var(--tinta);color:#fff;padding:10px 18px;border-radius:10px;
         opacity:0;pointer-events:none;transition:opacity .2s}
  #aviso.on{opacity:1}
  @media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>

<header class="topo">
  <div class="topo-in">
    <h1>Meu elenco</h1>
    <div class="resumo">
      <span><b><%= todos.length %></b> jogadores</span>
      <span>Valor do elenco: <b><%= todos.reduce((s, j) => s + Number(j.preco), 0).toLocaleString('pt-BR', { style: 'currency', currency: 'EUR' }) %></b></span>
    </div>
    <div class="abas" role="tablist">
      <button class="aba" role="tab" id="aba-elenco" aria-selected="true" aria-controls="sec-elenco">Elenco</button>
      <button class="aba" role="tab" id="aba-time" aria-selected="false" aria-controls="sec-time">Escalação</button>
    </div>
  </div>
</header>

<main>
  <!-- ELENCO -->
  <section id="sec-elenco" role="tabpanel" aria-labelledby="aba-elenco">
    <div class="acoes">
      <form class="busca" method="GET" action="/" role="search">
        <input type="search" name="q" value="<%= q %>" placeholder="Buscar por nome, posição, nacionalidade ou clube" aria-label="Buscar jogador">
        <button class="btn" type="submit">Buscar</button>
      </form>
      <% if (q) { %><a class="limpar-busca" href="/">Limpar busca</a><% } %>
      <button class="btn" id="btn-novo" type="button" style="margin-left:auto">Adicionar jogador</button>
    </div>

    <div class="tabela-wrap">
      <table>
        <thead>
          <tr>
            <th>Foto</th><th>ID</th><th>Nome</th><th>Posição</th>
            <th class="num">Preço</th><th>Nacionalidade</th><th>Clube</th><th></th>
          </tr>
        </thead>
        <tbody>
        <% if (jogadores.length === 0) { %>
          <tr><td colspan="8" class="vazio">
            <%= q ? 'Nenhum jogador encontrado para "' + q + '".' : 'Seu elenco está vazio. Adicione o primeiro jogador.' %>
          </td></tr>
        <% } %>
        <% jogadores.forEach(j => { %>
          <tr>
            <td>
              <div class="foto">
                <% if (j.foto) { %><img src="<%= j.foto %>" alt="" onerror="this.remove()"><% } %>
                <% if (!j.foto) { %><%= j.nome.split(' ').map(p => p[0]).slice(0, 2).join('') %><% } %>
              </div>
            </td>
            <td class="id"><%= j.id %></td>
            <td class="nome"><%= j.nome %></td>
            <td><span class="pos"><%= j.posicao %></span></td>
            <td class="num"><%= Number(j.preco).toLocaleString('pt-BR', { style: 'currency', currency: 'EUR' }) %></td>
            <td><%= j.nacionalidade %></td>
            <td><%= j.clube %></td>
            <td>
              <div class="linha-acoes">
                <button class="btn p claro" type="button" data-escalar="<%= j.id %>">Escalar</button>
                <button class="btn p amarelo" type="button" data-editar="<%= JSON.stringify(j) %>">Alterar</button>
                <form method="POST" action="/jogadores/<%= j.id %>/deletar"
                      onsubmit="return confirm('Deletar <%= j.nome.replace(/'/g, "\\'") %> do elenco?')">
                  <button class="btn p vermelho" type="submit">Deletar</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ESCALAÇÃO -->
  <section id="sec-time" role="tabpanel" aria-labelledby="aba-time" hidden>
    <div class="escalacao">
      <div class="campo" id="campo" aria-label="Campo de futebol">
        <div class="marca moldura"></div>
        <div class="marca meio"></div>
        <div class="marca circulo"></div>
        <div class="marca area-cima"></div>
        <div class="marca area-baixo"></div>
      </div>

      <div class="painel">
        <h2>Escalação</h2>
        <div class="controles">
          <label for="formacao" style="font-weight:600">Esquema</label>
          <select id="formacao"></select>
          <button class="btn claro" id="btn-limpar-time" type="button">Limpar time</button>
        </div>
        <ul class="lista-time" id="lista-time"></ul>
        <div class="total"><span>Valor do time</span><span id="total-time">€ 0,00</span></div>
      </div>
    </div>
  </section>
</main>

<!-- escolher jogador para uma posição do campo -->
<dialog id="dlg-escolha">
  <div class="dlg">
    <h3 id="escolha-titulo">Escolher jogador</h3>
    <input type="search" id="escolha-busca" placeholder="Buscar no elenco" aria-label="Buscar no elenco">
    <label class="check"><input type="checkbox" id="escolha-todos"> Mostrar jogadores de todas as posições</label>
    <ul id="lista-escolha"></ul>
    <div class="rodape">
      <button class="btn vermelho" type="button" id="escolha-remover" hidden>Tirar do time</button>
      <button class="btn claro" type="button" data-fechar>Fechar</button>
    </div>
  </div>
</dialog>

<!-- adicionar / alterar -->

<dialog id="dlg-form">
  <form class="dlg" method="POST" id="form-jogador" action="/jogadores" enctype="multipart/form-data">
    <h3 id="form-titulo">Adicionar jogador</h3>
    <input type="hidden" name="fotoAtual" id="f-foto-atual">

    <label for="f-nome">Nome</label>
    <input id="f-nome" name="nome" required maxlength="100">

    <label for="f-foto">Foto do jogador</label>
    <input id="f-foto" name="foto" type="file" accept="image/*">

    <div class="duas">
      <div>
        <label for="f-posicao">Posição</label>
        <select id="f-posicao" name="posicao" required>
          <option>Goleiro</option><option>Zagueiro</option><option>Lateral</option>
          <option>Volante</option><option>Meia</option><option>Atacante</option>
        </select>
      </div>
      <div>
        <label for="f-preco">Preço (€)</label>
        <input id="f-preco" name="preco" type="number" min="0" step="0.01" required>
      </div>
    </div>
    <div class="duas">
      <div>
        <label for="f-nac">Nacionalidade</label>
        <input id="f-nac" name="nacionalidade" maxlength="60">
      </div>
      <div>
        <label for="f-clube">Clube</label>
        <input id="f-clube" name="clube" maxlength="80">
      </div>
    </div>
    <div class="rodape">
      <button class="btn claro" type="button" data-fechar>Cancelar</button>
      <button class="btn" type="submit" id="form-salvar">Salvar jogador</button>
    </div>
  </form>
</dialog>

<div id="aviso" role="status"></div>

<script>
/* ---------- dados vindos do SQL ---------- */
const JOGADORES = <%- JSON.stringify(todos).replace(/</g, '\\u003c') %>;
const porId = id => JOGADORES.find(j => j.id === Number(id));

/* ---------- utilidades ---------- */
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const euro = n => Number(n).toLocaleString('pt-BR', { style: 'currency', currency: 'EUR' });
const norm = s => (s || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
const iniciais = nome => nome.split(' ').map(p => p[0]).slice(0, 2).join('');
const avatar = j => j.foto
  ? `<img src="${esc(j.foto)}" alt="" onerror="this.replaceWith(document.createTextNode('${esc(iniciais(j.nome))}'))">`
  : esc(iniciais(j.nome));

function grupo(pos) {
  const p = norm(pos);
  if (p.includes('gol')) return 'GK';
  if (p.includes('zag') || p.includes('lat') || p.includes('defen')) return 'DEF';
  if (p.includes('mei') || p.includes('vol')) return 'MID';
  return 'ATT';
}
let avisoTimer;
function avisar(msg) {
  const el = document.getElementById('aviso');
  el.textContent = msg; el.classList.add('on');
  clearTimeout(avisoTimer); avisoTimer = setTimeout(() => el.classList.remove('on'), 2400);
}

/* ---------- abas ---------- */
const abas = { 'aba-elenco': 'sec-elenco', 'aba-time': 'sec-time' };
Object.keys(abas).forEach(id => document.getElementById(id).addEventListener('click', () => {
  Object.entries(abas).forEach(([a, s]) => {
    document.getElementById(a).setAttribute('aria-selected', a === id);
    document.getElementById(s).hidden = a !== id;
  });
}));
const irParaTime = () => document.getElementById('aba-time').click();

/* ---------- adicionar / alterar ---------- */

const dlgForm = document.getElementById('dlg-form');
const form = document.getElementById('form-jogador');
document.querySelectorAll('[data-fechar]').forEach(b => b.addEventListener('click', () => b.closest('dialog').close()));

document.getElementById('btn-novo').addEventListener('click', () => {
  form.reset();
  form.action = '/jogadores';
  document.getElementById('f-foto-atual').value = '';
  document.getElementById('form-titulo').textContent = 'Adicionar jogador';
  dlgForm.showModal();
});
document.querySelectorAll('[data-editar]').forEach(btn => btn.addEventListener('click', () => {
  const j = JSON.parse(btn.dataset.editar);
  form.reset();
  form.action = `/jogadores/${j.id}/editar`;
  document.getElementById('form-titulo').textContent = 'Alterar jogador';
  document.getElementById('f-nome').value = j.nome;
  document.getElementById('f-foto-atual').value = j.foto || '';
  document.getElementById('f-posicao').value = j.posicao;
  document.getElementById('f-preco').value = j.preco;
  document.getElementById('f-nac').value = j.nacionalidade || '';
  document.getElementById('f-clube').value = j.clube || '';
  dlgForm.showModal();
}));
/* ---------- esquemas táticos (x e y em %, goleiro embaixo) ---------- */
const FORMACOES = {
  '4-3-3': [
    ['GK',50,90,'GOL'],
    ['DEF',12,72,'LE'],['DEF',37,76,'ZAG'],['DEF',63,76,'ZAG'],['DEF',88,72,'LD'],
    ['MID',25,53,'MC'],['MID',50,58,'VOL'],['MID',75,53,'MC'],
    ['ATT',18,25,'PE'],['ATT',50,17,'CA'],['ATT',82,25,'PD']
  ],
  '4-4-2': [
    ['GK',50,90,'GOL'],
    ['DEF',12,72,'LE'],['DEF',37,76,'ZAG'],['DEF',63,76,'ZAG'],['DEF',88,72,'LD'],
    ['MID',12,48,'ME'],['MID',37,54,'MC'],['MID',63,54,'MC'],['MID',88,48,'MD'],
    ['ATT',36,20,'CA'],['ATT',64,20,'CA']
  ],
  '3-5-2': [
    ['GK',50,90,'GOL'],
    ['DEF',24,74,'ZAG'],['DEF',50,78,'ZAG'],['DEF',76,74,'ZAG'],
    ['MID',9,50,'AE'],['MID',30,58,'MC'],['MID',50,46,'MEI'],['MID',70,58,'MC'],['MID',91,50,'AD'],
    ['ATT',36,20,'CA'],['ATT',64,20,'CA']
  ],
  '4-2-3-1': [
    ['GK',50,90,'GOL'],
    ['DEF',12,72,'LE'],['DEF',37,76,'ZAG'],['DEF',63,76,'ZAG'],['DEF',88,72,'LD'],
    ['MID',35,58,'VOL'],['MID',65,58,'VOL'],
    ['MID',18,38,'ME'],['MID',50,36,'MEI'],['MID',82,38,'MD'],
    ['ATT',50,16,'CA']
  ]
};

let formacao = '4-3-3';
let escalacao = Array(11).fill(null);   // id do jogador em cada posição
let slotAtual = null;

const selForm = document.getElementById('formacao');
selForm.innerHTML = Object.keys(FORMACOES).map(f => `<option>${f}</option>`).join('');

selForm.addEventListener('change', () => {
  // mantém os jogadores já escolhidos, encaixando por posição no novo esquema
  const sobra = escalacao.filter(Boolean).map(porId);
  formacao = selForm.value;
  escalacao = FORMACOES[formacao].map(([tipo]) => {
    const i = sobra.findIndex(j => grupo(j.posicao) === tipo);
    return i >= 0 ? sobra.splice(i, 1)[0].id : null;
  });
  desenhar();
});
document.getElementById('btn-limpar-time').addEventListener('click', () => {
  escalacao = Array(11).fill(null); desenhar();
});

function desenhar() {
  const slots = FORMACOES[formacao];
  const campo = document.getElementById('campo');
  campo.querySelectorAll('.slot').forEach(s => s.remove());

  slots.forEach(([tipo, x, y, rot], i) => {
    const j = escalacao[i] ? porId(escalacao[i]) : null;
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'slot' + (j ? ' cheio' : '');
    b.style.left = x + '%'; b.style.top = y + '%';
    b.setAttribute('aria-label', j ? `${rot}: ${j.nome}` : `Escolher jogador para ${rot}`);
    b.innerHTML = `<span class="bola">${j ? avatar(j) : '+'}</span>
                   <span class="rotulo">${j ? esc(j.nome.split(' ').slice(-1)[0]) : rot}</span>`;
    b.addEventListener('click', () => abrirEscolha(i));
    campo.appendChild(b);
  });

  // painel lateral
  let total = 0;
  document.getElementById('lista-time').innerHTML = slots.map(([tipo, x, y, rot], i) => {
    const j = escalacao[i] ? porId(escalacao[i]) : null;
    if (j) total += Number(j.preco);
    return j
      ? `<li><div class="foto">${avatar(j)}</div>
           <div class="quem"><strong>${esc(j.nome)}</strong><small>${rot} · ${esc(j.clube || '')}</small></div>
           <span>${euro(j.preco)}</span></li>`
      : `<li><div class="foto">${rot}</div><div class="quem livre">Vaga aberta</div></li>`;
  }).join('');
  document.getElementById('total-time').textContent = euro(total);
}

/* ---------- escolher jogador para uma vaga ---------- */
const dlgEscolha = document.getElementById('dlg-escolha');
const inpBusca = document.getElementById('escolha-busca');
const chkTodos = document.getElementById('escolha-todos');

function abrirEscolha(i) {
  slotAtual = i;
  const [tipo, , , rot] = FORMACOES[formacao][i];
  document.getElementById('escolha-titulo').textContent = `Escolher jogador: ${rot}`;
  document.getElementById('escolha-remover').hidden = !escalacao[i];
  inpBusca.value = ''; chkTodos.checked = false;
  listarEscolha();
  dlgEscolha.showModal();
}
function listarEscolha() {
  const tipo = FORMACOES[formacao][slotAtual][0];
  const t = norm(inpBusca.value);
  const lista = JOGADORES.filter(j =>
    (chkTodos.checked || grupo(j.posicao) === tipo) && norm(j.nome + ' ' + j.clube).includes(t));
  const ul = document.getElementById('lista-escolha');
  ul.innerHTML = lista.length ? lista.map(j => {
    const noTime = escalacao.includes(j.id);
    return `<li><button type="button" data-id="${j.id}">
      <div class="foto">${avatar(j)}</div>
      <div class="quem"><strong>${esc(j.nome)}</strong><small>${esc(j.posicao)}, ${esc(j.clube || '')}</small></div>
      ${noTime ? '<span class="usado">já escalado</span>' : ''}
    </button></li>`;
  }).join('') : '<li class="vazio" style="padding:20px;text-align:center;color:var(--suave)">Nenhum jogador disponível para essa posição.</li>';
}
inpBusca.addEventListener('input', listarEscolha);
chkTodos.addEventListener('change', listarEscolha);
document.getElementById('lista-escolha').addEventListener('click', e => {
  const b = e.target.closest('button[data-id]'); if (!b) return;
  const id = Number(b.dataset.id);
  const antigo = escalacao.indexOf(id);
  if (antigo >= 0) escalacao[antigo] = null;   // um jogador não pode ocupar duas vagas
  escalacao[slotAtual] = id;
  dlgEscolha.close(); desenhar();
});
document.getElementById('escolha-remover').addEventListener('click', () => {
  escalacao[slotAtual] = null; dlgEscolha.close(); desenhar();
});

/* ---------- botão "Escalar" na tabela ---------- */
document.querySelectorAll('[data-escalar]').forEach(btn => btn.addEventListener('click', () => {
  const j = porId(btn.dataset.escalar);
  if (escalacao.includes(j.id)) { avisar(`${j.nome} já está no time.`); return irParaTime(); }
  const g = grupo(j.posicao);
  const vaga = FORMACOES[formacao].findIndex(([tipo], i) => tipo === g && !escalacao[i]);
  if (vaga < 0) return avisar(`Não há vaga livre para ${j.posicao.toLowerCase()} no ${formacao}.`);
  escalacao[vaga] = j.id;
  desenhar(); irParaTime();
  avisar(`${j.nome} entrou no time.`);
}));

desenhar();
</script>
</body>
</html>
